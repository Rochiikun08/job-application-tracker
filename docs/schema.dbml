Table users {
  id bigint [pk, increment]
  email text [not null, unique]
  password_hash text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table applications {
  id bigint [pk, increment]
  user_id bigint [not null]
  company text [not null]
  role text [not null]
  job_url text
  location text
  source text
  status text [not null, default: 'wishlist', note: 'wishlist | applied | online_assessment | interview | offer | rejected | withdrawn']
  date_applied date
  follow_up_on date
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, company, role) [unique, name: 'uq_applications_user_company_role']
    (user_id, status) [name: 'idx_applications_user_status']
    (user_id, date_applied) [name: 'idx_applications_user_date_applied']
  }
}

Table status_history {
  id bigint [pk, increment]
  application_id bigint [not null]
  from_status text [note: 'null for the first entry']
  to_status text [not null, note: 'same allowed values as applications.status']
  changed_at timestamptz [not null, default: `now()`]
  note text

  indexes {
    application_id [name: 'idx_status_history_application_id']
  }
}

Table interviews {
  id bigint [pk, increment]
  application_id bigint [not null]
  kind text [not null, note: 'phone_screen | technical | behavioural | final | assessment']
  scheduled_at timestamptz [not null]
  location_or_link text
  outcome text [default: 'pending', note: 'pending | passed | failed']
  notes text

  indexes {
    application_id [name: 'idx_interviews_application_id']
  }
}

Ref: applications.user_id > users.id [delete: cascade]
Ref: status_history.application_id > applications.id [delete: cascade]
Ref: interviews.application_id > applications.id [delete: cascade]